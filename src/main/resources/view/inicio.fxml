<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="700.0" prefWidth="980.0" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.InicioController">
    <!-- ENCABEZADO SUPERIOR -->
    <top>
        <VBox styleClass="header-bar" BorderPane.alignment="CENTER">
            <children>
                <Label styleClass="header-title" text="RentCar - Sistema Integral de Gestión" />
                <Label styleClass="header-subtitle" text="Administración de Clientes, Vehículos, Modalidades, Servicios y Reservas" />
            </children>
        </VBox>
    </top>

    <!-- CUERPO PRINCIPAL CON PESTAÑAS -->
    <center>
        <TabPane fx:id="tabPanePrincipal" prefHeight="200.0" prefWidth="200.0" tabClosingPolicy="UNAVAILABLE" BorderPane.alignment="CENTER">
            <tabs>
                <!-- ============================================== -->
                <!-- PESTAÑA 1: GESTIÓN DE CLIENTES                -->
                <!-- ============================================== -->
                <Tab text="Gestión de Clientes">
                    <content>
                        <VBox spacing="15.0">
                            <padding>
                                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                            </padding>
                            <children>
                                <HBox spacing="15.0">
                                    <!-- Formulario Registro Cliente -->
                                    <VBox spacing="10.0" styleClass="card-panel" HBox.hgrow="NEVER" prefWidth="380.0">
                                        <children>
                                            <Label styleClass="card-title" text="Registrar Nuevo Cliente" />
                                            <GridPane hgap="8.0" vgap="8.0">
                                                <columnConstraints>
                                                    <ColumnConstraints minWidth="110.0" prefWidth="120.0" />
                                                    <ColumnConstraints hgrow="ALWAYS" minWidth="150.0" />
                                                </columnConstraints>
                                                <rowConstraints>
                                                    <RowConstraints minHeight="30.0" />
                                                    <RowConstraints minHeight="30.0" />
                                                    <RowConstraints minHeight="30.0" />
                                                    <RowConstraints minHeight="30.0" />
                                                    <RowConstraints minHeight="30.0" />
                                                </rowConstraints>
                                                <children>
                                                    <Label text="Nombre Completo:" />
                                                    <TextField fx:id="txtCliNombre" promptText="Ej: Juan Pérez" GridPane.columnIndex="1" />
                                                    <Label text="Documento:" GridPane.rowIndex="1" />
                                                    <TextField fx:id="txtCliDoc" promptText="Cédula / Pasaporte" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                                    <Label text="Teléfono:" GridPane.rowIndex="2" />
                                                    <TextField fx:id="txtCliTelefono" promptText="Ej: 3001234567 o 28" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                                    <Label text="Correo Electrónico:" GridPane.rowIndex="3" />
                                                    <TextField fx:id="txtCliCorreo" promptText="cliente@email.com" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                                                    <Label text="Edad:" GridPane.rowIndex="4" />
                                                    <TextField fx:id="txtCliEdad" promptText="Ej: 30" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                                                </children>
                                            </GridPane>
                                            <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#registrarCliente" styleClass="btn-primary" text="Registrar Cliente" />
                                        </children>
                                    </VBox>

                                    <!-- Panel de Consulta: Teléfono y Número Perfecto -->
                                    <VBox spacing="10.0" styleClass="card-panel" HBox.hgrow="ALWAYS">
                                        <children>
                                            <Label styleClass="card-title" text="Consulta de Cliente y Verificación de Número Perfecto" />
                                            <Label text="Busque un cliente por teléfono y verifique matemáticamente si su número es perfecto:" wrapText="true" />
                                            <HBox spacing="10.0">
                                                <children>
                                                    <TextField fx:id="txtTelefono" promptText="Ingrese teléfono (ej: 28, 6, 496...)" HBox.hgrow="ALWAYS" />
                                                    <Button mnemonicParsing="false" onAction="#verificarTelefonoCliente" styleClass="btn-success" text="Buscar y Verificar" />
                                                </children>
                                            </HBox>
                                            <Label fx:id="lblResultadoTelefono" text="Ingrese un número para verificar..." wrapText="true">
                                                <font>
                                                    <Font size="13.0" />
                                                </font>
                                            </Label>
                                        </children>
                                    </VBox>
                                </HBox>

                                <!-- Tabla de Clientes Registrados -->
                                <VBox spacing="5.0" VBox.vgrow="ALWAYS">
                                    <children>
                                        <Label style="-fx-font-weight: bold; -fx-text-fill: #34495e;" text="Clientes Registrados en la Empresa:" />
                                        <TableView fx:id="tblClientes" prefHeight="250.0" VBox.vgrow="ALWAYS">
                                            <columns>
                                                <TableColumn fx:id="colCliNombre" prefWidth="170.0" text="Nombre Completo" />
                                                <TableColumn fx:id="colCliDoc" prefWidth="110.0" text="Documento" />
                                                <TableColumn fx:id="colCliTel" prefWidth="120.0" text="Teléfono" />
                                                <TableColumn fx:id="colCliCorreo" prefWidth="190.0" text="Correo Electrónico" />
                                                <TableColumn fx:id="colCliEdad" prefWidth="60.0" text="Edad" />
                                                <TableColumn fx:id="colCliFecha" prefWidth="110.0" text="Fecha Registro" />
                                                <TableColumn fx:id="colCliPerfecto" prefWidth="130.0" text="¿Teléfono Perfecto?" />
                                            </columns>
                                        </TableView>
                                    </children>
                                </VBox>
                            </children>
                        </VBox>
                    </content>
                </Tab>

                <!-- ============================================== -->
                <!-- PESTAÑA 2: GESTIÓN DE VEHÍCULOS               -->
                <!-- ============================================== -->
                <Tab text="Gestión de Vehículos">
                    <content>
                        <VBox spacing="15.0">
                            <padding>
                                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                            </padding>
                            <children>
                                <HBox spacing="15.0">
                                    <!-- Formulario Registro Vehículo -->
                                    <VBox spacing="10.0" styleClass="card-panel" prefWidth="420.0">
                                        <children>
                                            <Label styleClass="card-title" text="Registrar Nuevo Vehículo" />
                                            <GridPane hgap="8.0" vgap="8.0">
                                                <columnConstraints>
                                                    <ColumnConstraints minWidth="100.0" prefWidth="110.0" />
                                                    <ColumnConstraints hgrow="ALWAYS" minWidth="150.0" />
                                                </columnConstraints>
                                                <rowConstraints>
                                                    <RowConstraints minHeight="30.0" />
                                                    <RowConstraints minHeight="30.0" />
                                                    <RowConstraints minHeight="30.0" />
                                                    <RowConstraints minHeight="30.0" />
                                                    <RowConstraints minHeight="30.0" />
                                                    <RowConstraints minHeight="30.0" />
                                                </rowConstraints>
                                                <children>
                                                    <Label text="Placa:" />
                                                    <TextField fx:id="txtVehPlaca" promptText="Ej: ABC123" GridPane.columnIndex="1" />
                                                    <Label text="Marca:" GridPane.rowIndex="1" />
                                                    <TextField fx:id="txtVehMarca" promptText="Ej: Toyota" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                                    <Label text="Modelo:" GridPane.rowIndex="2" />
                                                    <TextField fx:id="txtVehModelo" promptText="Ej: Corolla" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                                    <Label text="Año:" GridPane.rowIndex="3" />
                                                    <TextField fx:id="txtVehAnio" promptText="Ej: 2024" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                                                    <Label text="Tipo:" GridPane.rowIndex="4" />
                                                    <ComboBox fx:id="cbVehTipo" maxWidth="Infinity" promptText="Seleccione tipo..." GridPane.columnIndex="1" GridPane.rowIndex="4" />
                                                    <Label text="Tarifa Diaria ($):" GridPane.rowIndex="5" />
                                                    <TextField fx:id="txtVehTarifa" promptText="Ej: 120000" GridPane.columnIndex="1" GridPane.rowIndex="5" />
                                                </children>
                                            </GridPane>
                                            <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#registrarVehiculo" styleClass="btn-primary" text="Registrar Vehículo" />
                                        </children>
                                    </VBox>

                                    <!-- Tabla de Vehículos -->
                                    <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                        <children>
                                            <Label style="-fx-font-weight: bold; -fx-text-fill: #34495e;" text="Flota de Vehículos Registrados:" />
                                            <TableView fx:id="tblVehiculos" prefHeight="300.0" VBox.vgrow="ALWAYS">
                                                <columns>
                                                    <TableColumn fx:id="colVehPlaca" prefWidth="100.0" text="Placa" />
                                                    <TableColumn fx:id="colVehMarca" prefWidth="110.0" text="Marca" />
                                                    <TableColumn fx:id="colVehModelo" prefWidth="120.0" text="Modelo" />
                                                    <TableColumn fx:id="colVehAnio" prefWidth="70.0" text="Año" />
                                                    <TableColumn fx:id="colVehTipo" prefWidth="100.0" text="Tipo" />
                                                    <TableColumn fx:id="colVehTarifa" prefWidth="120.0" text="Tarifa Diaria ($)" />
                                                </columns>
                                            </TableView>
                                        </children>
                                    </VBox>
                                </HBox>
                            </children>
                        </VBox>
                    </content>
                </Tab>

                <!-- ============================================== -->
                <!-- PESTAÑA 3: MODALIDADES Y SERVICIOS             -->
                <!-- ============================================== -->
                <Tab text="Modalidades y Servicios">
                    <content>
                        <VBox spacing="15.0">
                            <padding>
                                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                            </padding>
                            <children>
                                <!-- Tabla Modalidades -->
                                <VBox spacing="5.0" VBox.vgrow="ALWAYS">
                                    <children>
                                        <Label styleClass="card-title" text="Modalidades de Alquiler Disponibles (Económica, Ejecutiva, Premium)" />
                                        <TableView fx:id="tblModalidades" prefHeight="200.0" VBox.vgrow="ALWAYS">
                                            <columns>
                                                <TableColumn fx:id="colModCodigo" prefWidth="100.0" text="Código" />
                                                <TableColumn fx:id="colModNombre" prefWidth="130.0" text="Modalidad" />
                                                <TableColumn fx:id="colModMinDias" prefWidth="100.0" text="Días Mínimos" />
                                                <TableColumn fx:id="colModValorDiario" prefWidth="120.0" text="Valor Diario ($)" />
                                                <TableColumn fx:id="colModEstado" prefWidth="100.0" text="Estado" />
                                                <TableColumn fx:id="colModBeneficios" prefWidth="350.0" text="Beneficios y Características Especiales" />
                                            </columns>
                                        </TableView>
                                    </children>
                                </VBox>

                                <!-- Tabla Servicios Adicionales -->
                                <VBox spacing="5.0" VBox.vgrow="ALWAYS">
                                    <children>
                                        <Label styleClass="card-title" text="Catálogo de Servicios Adicionales" />
                                        <TableView fx:id="tblServicios" prefHeight="180.0" VBox.vgrow="ALWAYS">
                                            <columns>
                                                <TableColumn fx:id="colSrvCodigo" prefWidth="110.0" text="Código" />
                                                <TableColumn fx:id="colSrvNombre" prefWidth="170.0" text="Servicio" />
                                                <TableColumn fx:id="colSrvPrecio" prefWidth="120.0" text="Precio ($)" />
                                                <TableColumn fx:id="colSrvDisponible" prefWidth="110.0" text="Disponibilidad" />
                                                <TableColumn fx:id="colSrvDesc" prefWidth="350.0" text="Descripción" />
                                            </columns>
                                        </TableView>
                                    </children>
                                </VBox>
                            </children>
                        </VBox>
                    </content>
                </Tab>

                <!-- ============================================== -->
                <!-- PESTAÑA 4: GESTIÓN DE RESERVAS                 -->
                <!-- ============================================== -->
                <Tab text="Gestión de Reservas">
                    <content>
                        <VBox spacing="15.0">
                            <padding>
                                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                            </padding>
                            <children>
                                <HBox spacing="15.0">
                                    <!-- Formulario Crear Reserva -->
                                    <VBox spacing="10.0" styleClass="card-panel" prefWidth="450.0">
                                        <children>
                                            <Label styleClass="card-title" text="Crear Nueva Reserva (Patrón Builder)" />
                                            <GridPane hgap="8.0" vgap="8.0">
                                                <columnConstraints>
                                                    <ColumnConstraints minWidth="120.0" prefWidth="130.0" />
                                                    <ColumnConstraints hgrow="ALWAYS" minWidth="180.0" />
                                                </columnConstraints>
                                                <rowConstraints>
                                                    <RowConstraints minHeight="30.0" />
                                                    <RowConstraints minHeight="30.0" />
                                                    <RowConstraints minHeight="30.0" />
                                                    <RowConstraints minHeight="30.0" />
                                                    <RowConstraints minHeight="30.0" />
                                                    <RowConstraints minHeight="30.0" />
                                                    <RowConstraints minHeight="90.0" />
                                                </rowConstraints>
                                                <children>
                                                    <Label text="Cliente:" />
                                                    <ComboBox fx:id="cbResCliente" maxWidth="Infinity" promptText="Seleccione cliente..." GridPane.columnIndex="1" />
                                                    
                                                    <Label text="Vehículo:" GridPane.rowIndex="1" />
                                                    <ComboBox fx:id="cbResVehiculo" maxWidth="Infinity" promptText="Seleccione vehículo..." GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                                    
                                                    <Label text="Modalidad:" GridPane.rowIndex="2" />
                                                    <ComboBox fx:id="cbResModalidad" maxWidth="Infinity" promptText="Seleccione modalidad..." GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                                    
                                                    <Label text="Fecha Inicio:" GridPane.rowIndex="3" />
                                                    <DatePicker fx:id="dpResInicio" maxWidth="Infinity" promptText="Fecha de inicio" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                                                    
                                                    <Label text="Fecha Fin:" GridPane.rowIndex="4" />
                                                    <DatePicker fx:id="dpResFin" maxWidth="Infinity" promptText="Fecha de devolución" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                                                    
                                                    <Label text="Descuento ($):" GridPane.rowIndex="5" />
                                                    <TextField fx:id="txtResDescuento" promptText="Ej: 0 o 15000" text="0" GridPane.columnIndex="1" GridPane.rowIndex="5" />
                                                    
                                                    <Label text="Servicios Extra:" GridPane.rowIndex="6" />
                                                    <ListView fx:id="lvServiciosDisponibles" prefHeight="90.0" GridPane.columnIndex="1" GridPane.rowIndex="6" />
                                                </children>
                                            </GridPane>

                                            <!-- Cotización y Creación -->
                                            <HBox alignment="CENTER_LEFT" spacing="10.0">
                                                <children>
                                                    <Button mnemonicParsing="false" onAction="#calcularCotizacion" styleClass="btn-warning" text="Calcular Total" />
                                                    <Label fx:id="lblTotalCotizacion" text="Total: $0.0" style="-fx-font-weight: bold; -fx-font-size: 14px;" />
                                                </children>
                                            </HBox>
                                            <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#crearReserva" styleClass="btn-success" text="Confirmar y Guardar Reserva" />
                                        </children>
                                    </VBox>

                                    <!-- Tabla de Reservas -->
                                    <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                        <children>
                                            <Label style="-fx-font-weight: bold; -fx-text-fill: #34495e;" text="Reservas Registradas:" />
                                            <TableView fx:id="tblReservas" prefHeight="350.0" VBox.vgrow="ALWAYS">
                                                <columns>
                                                    <TableColumn fx:id="colResCodigo" prefWidth="85.0" text="Código" />
                                                    <TableColumn fx:id="colResCliente" prefWidth="140.0" text="Cliente" />
                                                    <TableColumn fx:id="colResVehiculo" prefWidth="130.0" text="Vehículo" />
                                                    <TableColumn fx:id="colResModalidad" prefWidth="110.0" text="Modalidad" />
                                                    <TableColumn fx:id="colResFechas" prefWidth="160.0" text="Periodo" />
                                                    <TableColumn fx:id="colResDias" prefWidth="55.0" text="Días" />
                                                    <TableColumn fx:id="colResTotal" prefWidth="110.0" text="Total ($)" />
                                                </columns>
                                            </TableView>
                                        </children>
                                    </VBox>
                                </HBox>
                            </children>
                        </VBox>
                    </content>
                </Tab>

                <!-- ============================================== -->
                <!-- PESTAÑA 5: REPORTES E INGRESOS                -->
                <!-- ============================================== -->
                <Tab text="Reportes de Ingresos">
                    <content>
                        <VBox spacing="15.0">
                            <padding>
                                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                            </padding>
                            <children>
                                <VBox spacing="12.0" styleClass="card-panel">
                                    <children>
                                        <Label styleClass="card-title" text="Consulta de Ingresos Generados por Periodo de Fechas" />
                                        <Label text="Seleccione el rango de fechas para identificar las reservas realizadas dentro del periodo y acumular el valor total generado:" wrapText="true" />
                                        <HBox alignment="CENTER_LEFT" spacing="15.0">
                                            <children>
                                                <Label text="Desde:" />
                                                <DatePicker fx:id="dpFechaInicio" promptText="Fecha de Inicio" />
                                                <Label text="Hasta:" />
                                                <DatePicker fx:id="dpFechaFin" promptText="Fecha de Fin" />
                                                <Button mnemonicParsing="false" onAction="#calcularIngresosPeriodo" styleClass="btn-success" text="Calcular Ingresos del Periodo" />
                                            </children>
                                        </HBox>
                                        <Label fx:id="lblResultadoIngresos" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Total de Ingresos: $0.00" />
                                    </children>
                                </VBox>

                                <!-- Reservas del Periodo -->
                                <VBox spacing="5.0" VBox.vgrow="ALWAYS">
                                    <children>
                                        <Label style="-fx-font-weight: bold; -fx-text-fill: #34495e;" text="Detalle de Reservas Encontradas en el Periodo Consultado:" />
                                        <TableView fx:id="tblReservasPeriodo" prefHeight="250.0" VBox.vgrow="ALWAYS">
                                            <columns>
                                                <TableColumn fx:id="colPerCodigo" prefWidth="90.0" text="Código" />
                                                <TableColumn fx:id="colPerCliente" prefWidth="160.0" text="Cliente" />
                                                <TableColumn fx:id="colPerVehiculo" prefWidth="150.0" text="Vehículo" />
                                                <TableColumn fx:id="colPerModalidad" prefWidth="130.0" text="Modalidad" />
                                                <TableColumn fx:id="colPerFechas" prefWidth="170.0" text="Periodo" />
                                                <TableColumn fx:id="colPerTotal" prefWidth="120.0" text="Total ($)" />
                                            </columns>
                                        </TableView>
                                    </children>
                                </VBox>
                            </children>
                        </VBox>
                    </content>
                </Tab>
            </tabs>
        </TabPane>
    </center>
</BorderPane>